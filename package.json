{
  "name": "angular-survey-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "tailwind:build": "tailwindcss -i src/styles.css -o src/styles.tw.css --minify",
    "tailwind:watch": "tailwindcss -i src/styles.css -o src/styles.tw.css --watch",
    "start": "npm run tailwind:build && ng serve",
    "dev": "npm run tailwind:build && ng serve",
    "build": "npm run tailwind:build && ng build",
    "preview": "npm run tailwind:build && ng serve --port 4173",
    "watch": "npm run tailwind:build && ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@angular/service-worker": "^19.2.22",
    "@jsverse/transloco": "^8.3.0",
    "@tanstack/angular-table": "^8.21.4",
    "apexcharts": "^5.13.0",
    "ng-apexcharts": "1.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.0"
  }
}
